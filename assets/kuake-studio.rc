// kuake-studio 的 Windows 资源：exe 图标 + 属性面板里的版本信息。
// 只在 build.rs 检测到目标平台是 Windows 时才编译。

1 ICON "kuake-studio.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "lilyco-42"
            VALUE "FileDescription", "kuake-studio - Quark Drive client"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "kuake-studio"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
            VALUE "OriginalFilename", "kuake-studio.exe"
            VALUE "ProductName", "kuake-studio"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
